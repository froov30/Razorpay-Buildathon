# EntitleGraph Close Agent — environment template
# Copy to `.env` and fill in. NEVER commit the filled-in `.env`.
#
# Every value here is TEST MODE ONLY. This project must never be pointed at
# production credentials — see docs/TRD.md "Safety constraints".

# ---------------------------------------------------------------------------
# Razorpay — TEST MODE ONLY
# ---------------------------------------------------------------------------
# Get these from the Razorpay Dashboard in TEST mode:
#   Settings -> API Keys -> Generate Test Key
# A test-mode key id always starts with "rzp_test_". The client refuses to
# start if it sees a key beginning with "rzp_live_".
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Execution mode for the Razorpay client. One of:
#   LIVE-TEST  -> makes real API calls against Razorpay's test environment
#   MOCK       -> no network calls; local simulation (banner shown in UI)
# If unset, the client resolves to LIVE-TEST when valid test keys are present,
# otherwise MOCK — and it says so loudly in logs and in the dashboard banner.
ENTITLEGRAPH_RAZORPAY_MODE=

# ---------------------------------------------------------------------------
# LLM — contract clause extraction
# ---------------------------------------------------------------------------
# Used ONLY by the contract compiler, and only on a cache miss. Compiled
# policies are cached as canonical JSON, so evaluation runs are reproducible
# with this key absent. See docs/TRD.md "Determinism".
ANTHROPIC_API_KEY=
ENTITLEGRAPH_LLM_MODEL=claude-sonnet-5

# Alternative LLM backend. Google AI Studio issues keys with a free tier, so
# this is the cheaper route for reproducing the fidelity scores:
#   https://aistudio.google.com/apikey
# GOOGLE_API_KEY is also accepted as a fallback name.
GEMINI_API_KEY=
ENTITLEGRAPH_GEMINI_MODEL=gemini-3.5-flash

# NVIDIA NIM backend (OpenAI-compatible endpoint). Hosts open-weight models
# and issues generous free developer credits: https://build.nvidia.com/
NVIDIA_NIM_API_KEY=
ENTITLEGRAPH_NIM_MODEL=meta/llama-3.3-70b-instruct
ENTITLEGRAPH_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Compiler backend override. One of: llm | gemini | nim | deterministic
# Leave blank to auto-select: llm if ANTHROPIC_API_KEY is set, else gemini if a
# Google key is set, else nim if an NVIDIA key is set, else deterministic.
ENTITLEGRAPH_COMPILER_BACKEND=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
ENTITLEGRAPH_DB_PATH=data/synthetic/entitlegraph.db
